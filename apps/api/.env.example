# Copiá estas variables en Render → dentaflow-api → Environment
# (usá los mismos valores que en tu .env local)

PORT=3000
NODE_ENV=production

# PostgreSQL — Render la inyecta automáticamente si vinculás dentaflow-db
# DATABASE_URL=postgresql://...

DB_SYNCHRONIZE=true
SEED_ON_START=true

JWT_SECRET=generar-secreto-largo
JWT_REFRESH_SECRET=generar-otro-secreto
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
CLINIC_NAME=Mi Consultorio Odontológico
# Zona horaria para turnos, WhatsApp y emails (default: Argentina)
CLINIC_TIMEZONE=America/Argentina/Buenos_Aires

# Email (opcional — sin esto los mails se simulan)
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# WhatsApp Twilio (obligatorio para enviar WA real)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
