{
  "name": "dentaflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @dentaflow/shared build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "db:studio": "pnpm --filter api typeorm:studio",
    "db:seed": "pnpm --filter api db:seed"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
